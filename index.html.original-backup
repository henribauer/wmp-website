<!-- custom team overlay code -->
<div class="bio-overlay">
    <div class="bio-wrapper">
        <div class="bio-content">
            <div class="close"></div>
            <div class="bio-inner"></div>
        </div>
    </div>
</div>
<script>
	function _showPopup(content) {
		if (!content) { return; }
		jQuery('body').css('overflowY', 'hidden');
        jQuery('.bio-overlay').fadeIn();
        jQuery('.bio-inner').html(content);
	}
	
	function _closePopup() {
        jQuery('body').css('overflowY', 'auto');
        jQuery('.bio-overlay').fadeOut(300, function() {
	        jQuery('.bio-inner').html("");
		});
	}

    jQuery("a.info-link").click(function (e) {
        e.stopPropagation();
		_showPopup(jQuery(this).parent().parent().find(".bio-content-item").html());
		return false;
    });
		
	jQuery("#who-we-are-slider ul.slides li > *:first-child").click(function(e) {
        e.stopPropagation();
		_showPopup(jQuery(this).parent().find(".bio-content-item").html());
		return false;
	});

	jQuery(".team-member-image img").click(function(e) {
        e.stopPropagation();
		_showPopup(jQuery(this).parent().parent().find(".bio-content-item").html());
		return false;
	});

	jQuery(".bio-overlay").click(_closePopup);
	jQuery('.bio-content .close').click(_closePopup);
	jQuery(".bio-content").click(function (e) { e.stopPropagation() });
</script>


